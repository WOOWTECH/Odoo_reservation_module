<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Portal Home: "My Bookings" card                              -->
    <!-- ============================================================ -->
    <template id="portal_my_home_booking"
              name="My Bookings"
              customize_show="True"
              inherit_id="portal.portal_my_home"
              priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/reservation_module/static/src/img/booking.svg'"/>
                <t t-set="title">我的預約</t>
                <t t-set="url" t-value="'/my/ext-bookings'"/>
                <t t-set="text">查看與管理您的預約</t>
                <t t-set="placeholder_count" t-value="'booking_count'"/>
            </t>
        </div>
    </template>

    <!-- ============================================================ -->
    <!-- Portal Breadcrumbs                                            -->
    <!-- ============================================================ -->
    <template id="portal_my_home_menu_booking"
              name="Portal layout: booking menu entries"
              inherit_id="portal.portal_breadcrumbs"
              priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'ext_bookings'"
                class="breadcrumb-item active">
                我的預約
            </li>
            <li t-if="page_name == 'ext_booking_detail'"
                t-attf-class="breadcrumb-item">
                <a href="/my/ext-bookings">我的預約</a>
            </li>
            <li t-if="page_name == 'ext_booking_detail' and booking"
                class="breadcrumb-item active">
                <t t-out="booking.name"/>
            </li>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Portal: Booking List Page (/my/ext-bookings)                 -->
    <!-- ============================================================ -->
    <template id="portal_my_bookings" name="My Bookings">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">我的預約</t>
            </t>

            <t t-if="not bookings">
                <div class="alert alert-warning" role="alert">
                    目前還沒有預約紀錄。
                    <a href="/appointment" class="alert-link">立即預約</a>
                </div>
            </t>

            <t t-if="bookings">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th class="text-start">#</th>
                            <th>預約編號</th>
                            <th>服務項目</th>
                            <th>預約時間</th>
                            <th class="text-end">狀態</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="bookings" t-as="bk">
                            <tr>
                                <td class="text-start">
                                    <a t-attf-href="/my/ext-bookings/#{bk.id}">
                                        #<span t-out="bk.id"/>
                                    </a>
                                </td>
                                <td>
                                    <a t-attf-href="/my/ext-bookings/#{bk.id}">
                                        <span t-out="bk.name"/>
                                    </a>
                                </td>
                                <td>
                                    <span t-out="bk.appointment_type_id.name"/>
                                </td>
                                <td>
                                    <span t-field="bk.start_datetime" t-options='{"widget": "datetime", "format": "yyyy-MM-dd HH:mm"}'/>
                                </td>
                                <td class="text-end">
                                    <span t-if="bk.state == 'confirmed'"
                                          class="badge rounded-pill text-bg-success">
                                        已確認
                                    </span>
                                    <span t-if="bk.state == 'done'"
                                          class="badge rounded-pill text-bg-info">
                                        已完成
                                    </span>
                                    <span t-if="bk.state == 'cancelled'"
                                          class="badge rounded-pill text-bg-danger">
                                        已取消
                                    </span>
                                    <span t-if="bk.state == 'pending_payment'"
                                          class="badge rounded-pill text-bg-warning">
                                        待付款
                                    </span>
                                    <span t-if="bk.state == 'draft'"
                                          class="badge rounded-pill text-bg-secondary">
                                        草稿
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Portal: Booking Detail Page (/my/ext-bookings/<id>)          -->
    <!-- ============================================================ -->
    <template id="portal_my_booking_detail" name="My Booking Detail"
              inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="o_portal_fullwidth_alert" groups="base.group_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                       t-value="'/odoo/appointments/bookings/%s' % booking.id"/>
                </t>
            </t>

            <div class="row o_portal_booking_sidebar">
                <!-- ─── Sidebar ─── -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>

                    <t t-set="entries">
                        <div class="d-flex flex-wrap flex-column gap-4">
                            <!-- Sidebar Navigation -->
                            <div class="d-flex align-items-center flex-grow-1 p-0" t-ignore="true" role="complementary">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#card_header">
                                            預約資訊
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#booking_chat">
                                            歷史紀錄
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Status -->
                            <div class="d-flex flex-column gap-2">
                                <h6><small class="text-muted">狀態</small></h6>
                                <span t-if="booking.state == 'confirmed'"
                                      class="badge rounded-pill text-bg-success">
                                    已確認
                                </span>
                                <span t-if="booking.state == 'done'"
                                      class="badge rounded-pill text-bg-info">
                                    已完成
                                </span>
                                <span t-if="booking.state == 'cancelled'"
                                      class="badge rounded-pill text-bg-danger">
                                    已取消
                                </span>
                                <span t-if="booking.state == 'pending_payment'"
                                      class="badge rounded-pill text-bg-warning">
                                    待付款
                                </span>
                                <span t-if="booking.state == 'draft'"
                                      class="badge rounded-pill text-bg-secondary">
                                    草稿
                                </span>
                            </div>

                            <!-- Meeting Link -->
                            <div t-if="booking.meeting_url and booking.state in ('draft', 'pending_payment', 'confirmed')"
                                 class="d-flex flex-column gap-2">
                                <h6><small class="text-muted">線上會議</small></h6>
                                <a t-att-href="booking.meeting_url" target="_blank"
                                   class="btn btn-light btn-sm w-100 wt-reservation-action">
                                    <i class="fa fa-video-camera me-1"/>
                                    <t t-if="booking.discuss_channel_id">開啟會議室</t>
                                    <t t-else="">加入會議</t>
                                </a>
                            </div>

                            <!-- Payment -->
                            <div t-if="booking.payment_status == 'paid'"
                                 class="d-flex flex-column gap-2">
                                <h6><small class="text-muted">付款</small></h6>
                                <span class="text-success">
                                    <i class="fa fa-check-circle me-1"/>已付款
                                </span>
                            </div>
                            <div t-if="booking.payment_status == 'pending' and booking.sale_order_id"
                                 class="d-flex flex-column gap-2">
                                <h6><small class="text-muted">付款</small></h6>
                                <a t-attf-href="/my/orders/#{booking.sale_order_id.id}?access_token=#{booking.sale_order_id.access_token}"
                                   class="btn btn-primary btn-sm w-100 wt-reservation-action">
                                    <i class="fa fa-credit-card me-1"/>前往付款
                                </a>
                            </div>

                            <!-- Cancel Action -->
                            <div t-if="booking.state in ('draft', 'pending_payment', 'confirmed')"
                                 class="d-flex flex-column gap-2">
                                <form t-attf-action="/my/ext-bookings/#{booking.id}/cancel" method="POST" class="d-block">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 wt-reservation-action"
                                            onclick="return confirm('確定要取消此預約嗎？');">
                                        <i class="fa fa-times me-1"/>取消預約
                                    </button>
                                </form>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- ─── Main Content ─── -->
                <div id="booking_content" class="o_portal_content col-12 col-lg-8 col-xxl-9">
                    <div id="card">
                        <div id="card_header" data-anchor="true">
                            <div class="row justify-content-between mb-3">
                                <div class="col-12 col-md-9">
                                    <h3 class="my-0">
                                        <i class="fa fa-calendar me-1"/>
                                        <span t-out="booking.name"/>
                                        <small class="text-muted d-none d-md-inline">(#<span t-out="booking.id"/>)</small>
                                    </h3>
                                </div>
                                <div class="col-auto">
                                    <small class="text-end">狀態：</small>
                                    <span t-if="booking.state == 'confirmed'" class="badge rounded-pill text-bg-success">已確認</span>
                                    <span t-if="booking.state == 'done'" class="badge rounded-pill text-bg-info">已完成</span>
                                    <span t-if="booking.state == 'cancelled'" class="badge rounded-pill text-bg-danger">已取消</span>
                                    <span t-if="booking.state == 'pending_payment'" class="badge rounded-pill text-bg-warning">待付款</span>
                                    <span t-if="booking.state == 'draft'" class="badge rounded-pill text-bg-secondary">草稿</span>
                                </div>
                            </div>
                        </div>

                        <div id="card_body">
                            <!-- ─── Fix #5: Date card (event-style) ─── -->
                            <t t-set="tz" t-value="request.env.user.tz or 'Asia/Taipei'"/>
                            <t t-set="is_one_day" t-value="booking.start_datetime and booking.end_datetime and booking.start_datetime.date() == booking.end_datetime.date()"/>
                            <div class="o_wevent_dates_block mb-4 d-flex flex-wrap gap-3">
                                <div t-if="is_one_day" class="card border d-inline-flex align-items-end flex-row gap-2 p-2 p-md-3">
                                    <time t-field="booking.start_datetime"
                                          class="o_wevent_day_header_number lh-1"
                                          t-options="{'tz_name': tz, 'format': 'dd', 'date_only': 'true'}"/>
                                    <div class="small">
                                        <time t-field="booking.start_datetime" class="d-block lh-1"
                                              t-options="{'tz_name': tz, 'format': 'MMMM Y', 'date_only': 'true'}"/>
                                        <span class="fw-bold lh-1">
                                            <time t-out="booking.start_datetime"
                                                  t-options="{'widget':'datetime','tz_name':tz,'time_only':'true','format':'short'}"/>
                                            <i class="fa fa-long-arrow-right mx-1 text-muted"/>
                                            <time t-out="booking.end_datetime"
                                                  t-options="{'widget':'datetime','tz_name':tz,'time_only':'true','format':'short'}"/>
                                        </span>
                                    </div>
                                </div>
                                <t t-else="">
                                    <!-- Cross-day: two separate cards (Starts / Ends) -->
                                    <div class="card border d-inline-flex align-items-end flex-column gap-1 p-2 p-md-3">
                                        <small class="text-muted text-uppercase">開始</small>
                                        <div class="d-flex align-items-end gap-2">
                                            <time t-field="booking.start_datetime"
                                                  class="o_wevent_day_header_number lh-1"
                                                  t-options="{'tz_name': tz, 'format': 'dd', 'date_only': 'true'}"/>
                                            <div class="small">
                                                <time t-field="booking.start_datetime" class="d-block lh-1"
                                                      t-options="{'tz_name': tz, 'format': 'MMMM Y', 'date_only': 'true'}"/>
                                                <time t-out="booking.start_datetime" class="fw-bold lh-1"
                                                      t-options="{'widget':'datetime','tz_name':tz,'time_only':'true','format':'short'}"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card border d-inline-flex align-items-end flex-column gap-1 p-2 p-md-3">
                                        <small class="text-muted text-uppercase">結束</small>
                                        <div class="d-flex align-items-end gap-2">
                                            <time t-field="booking.end_datetime"
                                                  class="o_wevent_day_header_number lh-1"
                                                  t-options="{'tz_name': tz, 'format': 'dd', 'date_only': 'true'}"/>
                                            <div class="small">
                                                <time t-field="booking.end_datetime" class="d-block lh-1"
                                                      t-options="{'tz_name': tz, 'format': 'MMMM Y', 'date_only': 'true'}"/>
                                                <time t-out="booking.end_datetime" class="fw-bold lh-1"
                                                      t-options="{'widget':'datetime','tz_name':tz,'time_only':'true','format':'short'}"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <!-- ─── Fix #4: Add to Calendar (Apple / Outlook / Google) ─── -->
                            <div t-if="booking.state != 'cancelled'"
                                 class="mb-4 d-flex align-items-center flex-wrap gap-2">
                                <small class="text-muted">加入日曆：</small>
                                <a t-att-href="ics_url"
                                   class="btn btn-light btn-sm wt-reservation-action"
                                   title="Apple 行事曆" aria-label="加入 Apple 行事曆">
                                    <i class="fa fa-apple"/>
                                </a>
                                <a t-att-href="ics_url"
                                   class="btn btn-light btn-sm wt-reservation-action"
                                   title="Outlook" aria-label="加入 Outlook">
                                    <i class="fa fa-envelope-o"/>
                                    <span class="ms-1 d-none d-md-inline">Outlook</span>
                                </a>
                                <a t-att-href="google_url" target="_blank" rel="noopener"
                                   class="btn btn-light btn-sm wt-reservation-action"
                                   title="Google 行事曆" aria-label="加入 Google 行事曆">
                                    <i class="fa fa-google"/>
                                    <span class="ms-1 d-none d-md-inline">Google</span>
                                </a>
                            </div>

                            <!-- ─── Basic info (service, staff, guest count) ─── -->
                            <div class="row mb-4">
                                <div class="col-12 col-md-6">
                                    <div><strong>服務項目：</strong> <span t-out="booking.appointment_type_id.name"/></div>
                                    <div><strong>人數：</strong> <span t-out="booking.guest_count"/></div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div t-if="booking.staff_user_id">
                                        <strong>服務人員：</strong> <span t-out="booking.staff_user_id.name"/>
                                    </div>
                                </div>
                            </div>

                            <!-- ─── Fix #5: Location block (event-style) ─── -->
                            <div t-if="booking.resource_id or booking.appointment_type_id.location_id or booking.appointment_type_id.location_address"
                                 class="o_wevent_sidebar_block border-top pt-3 mt-3 mb-4">
                                <h6 class="o_wevent_sidebar_title text-uppercase text-muted mb-2">
                                    <i class="fa fa-map-marker me-1"/>地點
                                </h6>
                                <div t-if="booking.resource_id" class="mb-1 fw-bold" t-out="booking.resource_id.name"/>
                                <small t-if="booking.resource_id and booking.resource_id.location"
                                       class="d-block mb-2 text-muted"
                                       t-out="booking.resource_id.location"/>
                                <div t-if="booking.appointment_type_id.location_id"
                                     class="mb-1 fw-bold"
                                     t-out="booking.appointment_type_id.location_id.name"/>
                                <small t-if="booking.appointment_type_id.location_id"
                                       class="d-block mb-2"
                                       t-field="booking.appointment_type_id.location_id"
                                       t-options='{"widget":"contact","fields":["address"],"no_marker":true}'/>
                                <div t-if="not booking.appointment_type_id.location_id and booking.appointment_type_id.location_address"
                                     class="mb-2 text-muted"
                                     t-out="booking.appointment_type_id.location_address"/>
                                <t t-set="map_query" t-value="booking.appointment_type_id.location_id.contact_address or booking.appointment_type_id.location_address or ''"/>
                                <a t-if="map_query"
                                   t-attf-href="https://www.google.com/maps/search/?api=1&amp;query=#{map_query}"
                                   target="_blank" rel="noopener"
                                   class="btn btn-light btn-sm wt-reservation-action">
                                    <i class="fa fa-location-arrow me-1"/>取得路線
                                </a>
                            </div>

                            <!-- ─── Fix #5: Service description (Html rich text) ─── -->
                            <div t-if="booking.appointment_type_id.description" class="card border-0 bg-light mb-4">
                                <div class="card-body">
                                    <h5 class="card-title mb-2">服務說明</h5>
                                    <div t-field="booking.appointment_type_id.description"/>
                                </div>
                            </div>

                            <!-- ─── Fix #5: Notes (preserve line breaks) ─── -->
                            <div t-if="booking.notes" class="card border-0 bg-light mb-4">
                                <div class="card-body">
                                    <h5 class="card-title mb-2">備註</h5>
                                    <div class="small" style="white-space: pre-wrap;" t-out="booking.notes"/>
                                </div>
                            </div>

                            <!-- Meeting info for online meetings -->
                            <div t-if="booking.meeting_url and booking.state in ('draft', 'pending_payment', 'confirmed')"
                                 class="mb-4">
                                <h5 class="mb-1">線上會議</h5>
                                <hr class="mt-1 mb-2"/>
                                <p class="text-muted small">
                                    <i class="fa fa-video-camera me-1"/>
                                    <t t-if="booking.discuss_channel_id">
                                        這是一場線上會議。請點擊下方按鈕開啟會議室進行視訊通話：
                                    </t>
                                    <t t-else="">
                                        這是一場線上會議。請在預約時間使用以下連結加入：
                                    </t>
                                </p>
                                <a t-att-href="booking.meeting_url" target="_blank"
                                   class="btn btn-light btn-sm wt-reservation-action">
                                    <i class="fa fa-video-camera me-1"/>
                                    <t t-if="booking.discuss_channel_id">開啟會議室</t>
                                    <t t-else="">加入會議</t>
                                </a>
                                <p class="mt-2 small text-muted">
                                    <t t-out="booking.meeting_url"/>
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr/>
                    <!-- Communication history / Chatter -->
                    <div id="booking_chat" data-anchor="true">
                        <h3>溝通紀錄</h3>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="booking"/>
                            <t t-set="token" t-value="token"/>
                            <t t-set="allow_composer" t-value="allow_composer"/>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
